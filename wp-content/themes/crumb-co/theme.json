{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Cream", "color": "#FBF6EE" },
				{ "slug": "surface", "name": "Warm cream", "color": "#F4EADB" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Cocoa", "color": "#3B2A20" },
				{ "slug": "muted", "name": "Soft cocoa", "color": "#6B5546" },
				{ "slug": "line", "name": "Crumb line", "color": "#E6D9C6" },
				{ "slug": "accent", "name": "Raspberry", "color": "#B8325A" },
				{ "slug": "accent-dark", "name": "Deep raspberry", "color": "#932446" },
				{ "slug": "accent-light", "name": "Raspberry cream", "color": "#F6DCE3" },
				{ "slug": "sage", "name": "Sage", "color": "#7E9C7C" },
				{ "slug": "sage-dark", "name": "Deep sage", "color": "#4F6B4E" },
				{ "slug": "sage-light", "name": "Sage cream", "color": "#E3EBDD" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 6vw, 5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3.5rem, 9vw, 7.5rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.35rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.45rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "2.75rem", "fluid": { "min": "2.1rem", "max": "3.4rem" } },
				{ "slug": "huge", "name": "Hero", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			],
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Fraunces (headings)",
					"fontFamily": "Fraunces, Cairo, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontWeight": "300 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Fraunces", "fontWeight": "300 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" },
						{ "fontFamily": "Fraunces", "fontWeight": "300 900", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-latin-wght-italic.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "Nunito (body)",
					"fontFamily": "Nunito, Cairo, 'Segoe UI', system-ui, -apple-system, sans-serif",
					"fontFace": [
						{ "fontFamily": "Nunito", "fontWeight": "300 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" },
						{ "fontFamily": "Nunito", "fontWeight": "300 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" }
					]
				},
				{
					"slug": "arabic",
					"name": "Cairo (Arabic)",
					"fontFamily": "Cairo, 'Segoe UI', Tahoma, sans-serif",
					"fontFace": [
						{ "fontFamily": "Cairo", "fontWeight": "300 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/cairo-arabic-wght-normal.woff2" ], "unicodeRange": "U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC" }
					]
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 18px 40px -18px rgba(59, 42, 32, 0.28)" },
				{ "slug": "lift", "name": "Lift", "shadow": "0 24px 60px -24px rgba(59, 42, 32, 0.35)" }
			]
		},
		"custom": {
			"radius": { "small": "10px", "medium": "18px", "large": "28px", "pill": "999px" },
			"lineHeight": { "tight": "1.12", "body": "1.65" }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "clamp(1rem, 4vw, 2.5rem)", "right": "clamp(1rem, 4vw, 2.5rem)", "top": "0", "bottom": "0" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.12", "letterSpacing": "-0.01em" },
				"color": { "text": "var(--wp--preset--color--contrast)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-dark)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.6em", "right": "1.6em" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "800", "fontSize": "1rem", "lineHeight": "1.2" },
				":hover": { "color": { "background": "var(--wp--preset--color--accent-dark)", "text": "var(--wp--preset--color--white)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--contrast)", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"caption": { "color": { "text": "var(--wp--preset--color--muted)" }, "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "1.35rem", "fontWeight": "700" },
				"elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--contrast)" } } }
			},
			"core/separator": { "color": { "text": "var(--wp--preset--color--line)" } },
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "3px", "style": "solid" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontStyle": "italic" }
			},
			"core/details": {
				"border": { "bottom": { "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" } },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem" } }
			},
			"core/search": {
				"border": { "radius": "999px" }
			},
			"core/post-title": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "shop-sidebar", "title": "Shop sidebar", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page — full width (no title band)", "postTypes": [ "page" ] }
	]
}
