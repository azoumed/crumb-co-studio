#: patterns/page-contact.php:24
msgid "Help with an order"
msgstr "المساعدة في طلب"

#: patterns/page-contact.php:26
msgid "Include your order number"
msgstr "اذكر رقم طلبك"

#: patterns/page-contact.php:27
msgid "Tell us which file and which software you are using"
msgstr "أخبرنا بالملف والبرنامج الذي تستخدمه"

#: patterns/page-contact.php:28
msgid "A screenshot of any error message helps"
msgstr "لقطة شاشة لرسالة الخطأ تساعدنا"

